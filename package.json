{
  "name": "tic-tac-plane",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open",
    "build": "ng build",
    "build:watch": "ng build --watch --configuration development",
    "build:server": "esbuild server/server.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist-server/server.js",
    "build:all": "npm run build && npm run build:server",
    "start:server": "node dist-server/server.js",
    "dev:server": "npm run build:server && node dist-server/server.js",
    "test": "ng test",
    "test:once": "ng test --no-watch",
    "test:coverage": "ng test --no-watch --coverage"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "express": "^4.22.3",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "ws": "^8.18.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.2",
    "vitest": "^4.1.12"
  }
}
