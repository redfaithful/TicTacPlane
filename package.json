{
  "name": "tic-tac-plane",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open",
    "build": "ng build",
    "build:watch": "ng build --watch --configuration development",
    "build:server": "esbuild server/server.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist-server/server.js",
    "build:all": "npm run build && npm run build:server",
    "start:server": "node dist-server/server.js",
    "dev:server": "npm run build:server && node dist-server/server.js",
    "test": "ng test",
    "test:once": "ng test --no-watch --browsers=ChromeHeadless"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/platform-browser": "^22.0.8",
    "@angular/platform-browser-dynamic": "^22.0.8",
    "@angular/router": "^22.0.8",
    "express": "^4.21.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "ws": "^8.18.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.0.9",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.8",
    "@types/express": "^4.17.21",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.2",
    "jasmine-core": "^6.3.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "typescript": "~6.0.2"
  }
}
